{
  "name": "giftwise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "postinstall": "node scripts/vendor-bryntum.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "verify-ledger": "tsx --env-file=.env.local scripts/verify-ledger.ts",
    "test:clean": "tsx --env-file=.env.local scripts/clean-test-data.ts",
    "e2e:api": "node --env-file-if-exists=.env.local tests/e2e/api.mjs",
    "e2e:ui": "node --env-file-if-exists=.env.local tests/e2e/ui.mjs",
    "e2e:paypal": "node --env-file-if-exists=.env.local tests/e2e/paypal-button.mjs",
    "e2e:monthly": "node --env-file-if-exists=.env.local tests/e2e/monthly.mjs",
    "e2e:a11y": "node tests/e2e/pages-a11y.mjs",
    "e2e:routed": "tsx --env-file=.env.local scripts/routed-gift-e2e.ts",
    "e2e:agent": "node --env-file-if-exists=.env.local tests/e2e/agent-checkout.mjs",
    "e2e:manage": "tsx --env-file=.env.local scripts/manage-e2e.ts",
    "postman": "node scripts/postman-collection.mjs",
    "test:postman": "node scripts/run-postman.mjs",
    "test:ledger-race": "tsx --env-file=.env.local scripts/ledger-race.ts 60",
    "checks:local": "cd workflows && tsx --env-file=../.env.local src/local.ts",
    "eval:ssa": "tsx --env-file=.env.local scripts/run-ssa-examples.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@bryntum/calendar": "npm:@bryntum/calendar-trial@7.3.7",
    "@bryntum/calendar-react": "7.3.7",
    "@floating-ui/react": "^0.27.20",
    "@onkernel/sdk": "^0.139.0",
    "@paypal/mcp": "1.8.1",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "@renderinc/sdk": "1.7.0",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
