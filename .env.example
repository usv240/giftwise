# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public URL of the app (used for links in emails and metadata)
APP_URL=http://localhost:3000

# Anthropic (console.anthropic.com > API keys). Powers bill reading, fundraiser reading and the two reviewers.
ANTHROPIC_API_KEY=

# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox > your app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Webhook ID shown after you add a webhook URL to the sandbox app (needed to verify webhooks)
PAYPAL_WEBHOOK_ID=
# Sandbox business accounts (developer.paypal.com > Testing Tools > Sandbox Accounts) used as payees in the demo
PAYPAL_VENDOR_EMAIL=
# Optional: one sandbox business account per sample shop, so each is paid separately. Unset ones use PAYPAL_VENDOR_EMAIL.
PAYPAL_VENDOR_EMAIL_RIVERSIDE=
PAYPAL_VENDOR_EMAIL_EASTGATE=
PAYPAL_VENDOR_EMAIL_NORTHSIDE=
PAYPAL_ABLE_EMAIL=

# Optional, for running the PayPal checkout test (npm run e2e:paypal). The sandbox personal account from
# developer.paypal.com > Testing Tools > Sandbox Accounts. The demo's own login is in TESTING.md.
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# Salt for hashing visitor addresses in rate limits. Any long random string; set one in production.
AUDIT_SALT=

# Database (local: docker compose up -d; Render: the managed Postgres connection string)
DATABASE_URL=postgres://giftwise:giftwise@localhost:5432/giftwise

# Optional. Elastic Cloud Serverless (the Elasticsearch endpoint and an API key) for "Ask the rulebook": hybrid search
# with jina-embeddings-v3 and jina-reranker-v3. Unset, an in-app keyword search stands in.
ELASTIC_URL=
ELASTIC_API_KEY=

# Optional. Channel3 (trychannel3.com/developers, promo code PAYPAL-HACKATHON-2026) for the gift finder. Unset, a
# sample catalog stands in.
CHANNEL3_API_KEY=

# AG Studio trial license key
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# Astropods hosted reviewer agent
ASTROPODS_AGENT_URL=
ASTROPODS_API_KEY=

# Feature switches: force a fallback even when a key is set
FALLBACK_ELASTIC=false
FALLBACK_KERNEL=false
FALLBACK_ZAPIER=false
FALLBACK_ASTROPODS=false

# Outside checks (workflows/): the shared secret, and on Render the workflow slug and an API key to start runs
CHECKS_SECRET=
CHECKS_WORKFLOW_SLUG=
RENDER_API_KEY=

# Local test runs only: replay an identical Claude request from disk instead of paying for it again. Leave unset when hosting.
# AI_CACHE_DIR=.ai-cache
